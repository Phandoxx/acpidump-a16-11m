                        Notify (\_SB.TZ40, 0x81) // Thermal Trip Point Change
                        Break
                    }
                    ElseIf ((_T_0 == 0x37))
                    {
                        Notify (\_SB.ADP1, 0x80) // Status Change
                        Notify (\_SB.BAT0, 0x80) // Status Change
                        Break
                    }
                    ElseIf ((_T_0 == 0x50))
                    {
                        Debug = "Fan 1 status change"
                        \_SB.I2C6._DSM (\_SB.I2C6.DSME, Zero, \_SB.I2C6.EF01, 0x11)
                        Return (Buffer (One)
