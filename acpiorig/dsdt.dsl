        Device (FECI)
        {
            Name (_HID, "QCOM0D05")  // _HID: Hardware ID
            Name (_UID, Zero)  // _UID: Unique ID
            Name (F1ST, Zero)
            Name (F1SP, Zero)
            Name (F2ST, Zero)
            Name (F2SP, Zero)
