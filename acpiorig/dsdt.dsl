                {
                    Name (_T_0, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                    _T_0 = ToInteger (QECS)
                    If ((_T_0 == 0x20))
                    {
                        Debug = "EC_QUERY_USB_EVENT 0x20"
                        Break
                    }
                    ElseIf ((_T_0 == 0x21))
                    {
                        Debug = "EC_QUERY_UCSI_EVENT 0x21"
                        Break
                    }
                    ElseIf ((_T_0 == 0x22))
                    {
                        Debug = "EC_QUERY_HPD_EVENT 0x22"
                        Break
                    }
                    ElseIf ((_T_0 == 0x24))
