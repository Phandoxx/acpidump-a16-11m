                    Debug = "TZ 39 while loop"
                    Debug = CNTR /* \_SB_.TZ39.CNTR */
                    Debug = CNTM /* \_SB_.TZ39.CNTM */
                    CNTR++
                    \_SB.I2C6.ECNR (\_SB.I2C6.TRT1)
