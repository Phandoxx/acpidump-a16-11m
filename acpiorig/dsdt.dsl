                                })
                            }
                            ElseIf ((_T_1 == One))
                            {
                                Return (Package (0x01)
                                {
                                    0x01C0
                                })
                            }
                            Else
                            {
                                BreakPoint
                            }

                            Break
                        }
                    }
                    ElseIf ((_T_0 == ToUUID ("98b9b2a4-1663-4a5f-82f2-c6c99a394726") /* Unknown UUID */))
                    {
                        While (One)
                        {
