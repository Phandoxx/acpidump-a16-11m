                    _T_0 = ToInteger (Arg0)
                    If ((_T_0 == 0x04))
                    {
                        \_SB.QPPX.WLEN = Zero
                        Sleep (0x1F)
                        \_SB.QPPX.WLEN = One
                        Sleep (0x0A)
                        Debug = "Reset 4 pass"
                    }
                    ElseIf ((_T_0 == 0x05))
                    {
