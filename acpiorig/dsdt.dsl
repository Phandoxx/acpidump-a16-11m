                        Sleep (0x0190)
                        Debug = "Set GPIO 4C to Low"
                        \_SB.WWAN.NPON = Zero
                        Sleep (0xFF)
                        Debug = "SOC EM GPIO 221 to Low"
                        \_SB.WWAN.EMDR = Zero
                        Sleep (0xC8)
                        Debug = "SOC EM GPIO 221 to High"
                        \_SB.WWAN.EMDR = One
                        Sleep (0x05)
                        Debug = "Set GPIO 4C to High"
                        \_SB.WWAN.NPON = One
                        Sleep (0xA5)
                        Sleep (0x32)
                        Debug = "End SDX65 Reset Sequence"
