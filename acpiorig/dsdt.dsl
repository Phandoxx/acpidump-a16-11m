                                        {
                                             0x00                                             // .
                                        })
                                    }

                                    Break
                                }
                            }
                            ElseIf ((_T_2 == One))
                            {
                                Debug = "GPIO Version"
                                Return (GPIV) /* \_SB_.GIO0.GPIV */
                            }
                            ElseIf ((_T_2 == 0x02))
                            {
